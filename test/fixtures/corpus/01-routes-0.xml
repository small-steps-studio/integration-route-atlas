<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">
  <onException>
    <exception>java.io.IOException</exception>
  </onException>
  <route>
    <from uri="seda:jobs"/>
    <wireTap uri="https://partner.example.test/api"/>
    <to uri="sql:select 1"/>
    <toD uri="bean:orderService"/>
    <toD uri="ftp://files.example.test/in?password=plain"/>
    <doTry>
      <to uri="direct:risky"/>
      <doCatch><exception>java.lang.Exception</exception></doCatch>
    </doTry>
  </route>
  <route id="dup">
    <from uri="kafka:events?brokers=localhost:9092"/>
    <wireTap uri="bean:orderService"/>
  </route>
</routes>
